# DeepSeek credentials.
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server
REEPI_PORT=8787
REEPI_HOST=127.0.0.1
REEPI_DB=data/reepi.sqlite

# How often to snapshot the database while the server runs, in minutes.
# 0 or absent means no scheduled snapshot: the server still takes one
# automatically before any schema migration, and `npm run db:backup` takes one
# on demand. Turn this on for an unattended deployment.
REEPI_BACKUP_EVERY_MINUTES=0
